{
  "$id": "urn:scriptkit:contracts:DependencyLock:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "enum": [
        "pip",
        "apt",
        "brew",
        "winget"
      ],
      "type": "string"
    },
    "packages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "description": "expected portable lowercase relative POSIX path; no traversal, devices or trailing dots",
                "maxLength": 240,
                "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:\\.|/|$))[a-z0-9_][a-z0-9_.-]*(?<!\\.)(?:/(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:\\.|/|$))[a-z0-9_][a-z0-9_.-]*(?<!\\.))*$(?![\\s\\S])",
                "type": "string"
              },
              "sha256": {
                "description": "expected lowercase SHA-256, 64 hex characters",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
                "type": "string"
              },
              "size": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "path",
              "sha256",
              "size"
            ],
            "type": "object"
          },
          "name": {
            "description": "expected normalized package identifier, not a path or command",
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$(?![\\s\\S])",
            "type": "string"
          },
          "version": {
            "description": "expected exact numeric-leading backend version, not a range, tag or command",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[0-9][A-Za-z0-9.+:~_-]*$(?![\\s\\S])",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "artifact"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "platform": {
      "additionalProperties": false,
      "properties": {
        "arch": {
          "enum": [
            "x86_64",
            "arm64"
          ],
          "type": "string"
        },
        "os": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ],
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch"
      ],
      "type": "object"
    },
    "python": {
      "additionalProperties": false,
      "properties": {
        "maximum_exclusive": {
          "description": "expected Python 3.x.y release",
          "pattern": "^3\\.(?:[1-9][0-9])\\.(?:0|[1-9][0-9]*)$(?![\\s\\S])",
          "type": "string"
        },
        "minimum": {
          "description": "expected Python 3.x.y release",
          "pattern": "^3\\.(?:[1-9][0-9])\\.(?:0|[1-9][0-9]*)$(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum_exclusive"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "platform",
    "python",
    "backend",
    "packages"
  ],
  "title": "DependencyLock",
  "type": "object"
}
